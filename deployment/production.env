# Curation workbench production env bundle for the goat swarm stack.
#
# Pass-reference style: NO real secrets here. $(pass ...) references are
# expanded at deploy time and piped straight into a swarm secret; plaintext
# secrets never touch disk. The `pass` entries live under webdev/curate/;
# `cloud-management/gcp/compute/bin/deploy.sh --push-secrets curate` pushes the
# secret (see deployment/deploy.md). The secret is mounted only in the API and
# the sync worker; the plugin runner gets no secret at all.
#
# CWB_ENV=production is load-bearing: validate_production_security()
# (src/curation_workbench/hosted/security.py) REFUSES to boot if a snapgate
# secret is still its built-in test default, DEBUG or DEMO_LOGIN is on,
# CWB_PUBLIC_URL is not https, OIDC_REDIRECT_URI does not start with
# CWB_PUBLIC_URL, FRONTEND_URL is not CWB_PUBLIC_URL, or
# SNAPGATE_SUPERADMIN_EMAILS is empty. The worker refuses to start in
# production without CWB_RUNNER_URL (set in the stack file, not here).
#
# (No inline comments on export lines: the deploy script passes the whole rest
# of the line through as the value.)

# --- runtime mode ---
export CWB_ENV=production
export CWB_PUBLIC_URL=https://curate.databio.org

# --- Postgres (shared goat postgres over databio_net) ---
export POSTGRES_DB=curate
export POSTGRES_USER=curate
export POSTGRES_PASSWORD=$(pass webdev/curate/db_password)
export POSTGRES_HOST=postgres
export POSTGRES_PORT=5432
# No CWB_DATABASE_URL: the store composes one from POSTGRES_* itself, with the
# password percent-encoded.

# --- snapgate (sign-in through Prosopia + JWT) ---
# The workbench is a first-party client of Prosopia (OpenID Connect), added with
#   prosopia oauth add-client curate --name "Curation Workbench" \
#     --redirect-uri https://curate.databio.org/auth/login/callback \
#     --redirect-uri http://127.0.0.1:8134/auth/login/callback
# whose printed secret goes in pass (deployment/deploy.md). No OIDC_ADOPT_CLAIM:
# nobody ever signed in to this app with Google directly, so there are no old
# rows to move onto a Prosopia identity.
export OIDC_ISSUER=https://prosopia.databio.org
export OIDC_CLIENT_ID=curate
export OIDC_CLIENT_SECRET=$(pass webdev/curate/oidc_client_secret)
export OIDC_REDIRECT_URI=https://curate.databio.org/auth/login/callback
export OIDC_LABEL=Prosopia
export JWT_SECRET_KEY=$(pass webdev/curate/jwt_secret)
export SESSION_SECRET_KEY=$(pass webdev/curate/session_secret)
export FRONTEND_URL=https://curate.databio.org
export ALLOWED_ORIGINS=https://curate.databio.org

# The real client IP for snapgate's OWN login rate limiter and the app's own
# in-process rate limits. curate.databio.org is proxied through Cloudflare,
# which overwrites CF-Connecting-IP on every proxied request.
export RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP
export CWB_CLIENT_IP_HEADER=CF-Connecting-IP
# Never enable demo-login in production.
export DEBUG=false
export DEMO_LOGIN=false
# Site superadmin (approves accounts, builds teams, registers projects and
# approves plugin code). This is Nathan's account, matched on the verified
# email Prosopia returns. Production refuses to boot without one.
export SNAPGATE_SUPERADMIN_EMAILS=nsheff@databio.org

# --- GitHub ---
# No GitHub token. The worker fetches public repos (ONGA is public) with no
# credentials, and opening pull requests is not built. When the pull-request
# feature lands, its write token goes in HERE as a new pass-backed line, and
# only the publisher gets it; CWB_GITHUB_READ_TOKEN would be the (optional)
# read-only token for a private repo.
