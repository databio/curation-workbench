# Hosted mode settings. Copy to .env, then: set -a; source .env; set +a
# The hosted store is Postgres through psycopg 3 (postgresql+psycopg://).
# scripts/dev-db.sh url
CWB_DATABASE_URL=postgresql+psycopg://cwb:cwb@127.0.0.1:55436/cwb
# Or, instead of CWB_DATABASE_URL (the password is percent-encoded for you):
# POSTGRES_DB=cwb
# POSTGRES_USER=cwb
# POSTGRES_PASSWORD=cwb
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=55436
# Migrations directory (default: deployment/migrations in the checkout)
# CWB_MIGRATIONS_DIR=deployment/migrations
