# Hosted mode settings. Copy to .env, then: set -a; source .env; set +a
# The hosted store is Postgres through psycopg 3 (postgresql+psycopg://).
# scripts/dev-db.sh url
CWB_DATABASE_URL=postgresql+psycopg://cwb:cwb@127.0.0.1:55436/cwb
# Or, instead of CWB_DATABASE_URL (the password is percent-encoded for you):
# POSTGRES_DB=cwb
# POSTGRES_USER=cwb
# POSTGRES_PASSWORD=cwb
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=55436
# Migrations directory (default: deployment/migrations in the checkout)
# CWB_MIGRATIONS_DIR=deployment/migrations

# ---- Hosted service (cwb hosted serve) -------------------------------------
# dev | test | production (unset = production: refuses dev flags and test secrets)
CWB_ENV=dev
# The public origin; production: https://curate.databio.org
CWB_PUBLIC_URL=http://127.0.0.1:8134
# Built SPA folder (default: the packaged curation_workbench/web/)
# CWB_FRONTEND_DIST=src/curation_workbench/web
# Header with the real client IP behind the proxy (production: CF-Connecting-IP)
# CWB_CLIENT_IP_HEADER=CF-Connecting-IP
# CWB_RATE_LIMITS=off                      # switch the in-process limits off
# CWB_RL_USER_REQUESTS=1200/60             # count/seconds override for one bucket
# Sync worker settings (CWB_SYNC_DIR, CWB_RUNNER_URL, ...): dev-docs/sync.md
CWB_SYNC_DIR=var/sync

# ---- snapgate (sign-in through Prosopia; snapgate's own names) -------------
# The Prosopia OIDC client `curate` (registered in Prosopia by Nathan). Its
# redirect URIs include http://127.0.0.1:8134/auth/login/callback for dev.
OIDC_ISSUER=https://prosopia.databio.org
OIDC_CLIENT_ID=curate
OIDC_CLIENT_SECRET=<from Prosopia>
OIDC_REDIRECT_URI=http://127.0.0.1:8134/auth/login/callback
OIDC_LABEL=Prosopia
# 32+ characters each; never these values outside dev
JWT_SECRET_KEY=dev-only-0123456789abcdef0123456789
SESSION_SECRET_KEY=dev-only-abcdef0123456789abcdef0123
# The SPA origin (same as CWB_PUBLIC_URL; Vite dev: http://127.0.0.1:5190)
FRONTEND_URL=http://127.0.0.1:8134
ALLOWED_ORIGINS=http://127.0.0.1:8134,http://127.0.0.1:5190
# RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP
# Site roles (comma-separated emails). A superadmin approves accounts and builds teams.
SNAPGATE_SUPERADMIN_EMAILS=admin@demo.local
SNAPGATE_ADMIN_EMAILS=
# Dev only (refused in production): POST /auth/demo-login/admin|user
DEMO_LOGIN=true
DEBUG=false
